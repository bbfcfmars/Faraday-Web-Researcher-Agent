# Faraday Web Research Agent - Environment Configuration
# Copy this file to .env and fill in your API keys

# ============================================
# REQUIRED: At least one LLM provider is needed
# ============================================

# Option 1: Google Gemini (Recommended for quick start - free tier available)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash-preview-04-17

# Option 2: Azure OpenAI (Primary)
# AZURE_OPENAI_API_KEY_O3_mini=your_azure_key_here
# AZURE_OPENAI_ENDPOINT_O3_mini=https://your-resource.openai.azure.com/
# AZURE_OPENAI_API_VERSION_O3_mini=2024-02-15-preview
# AZURE_OPENAI_CHAT_DEPLOYMENT_NAME_O3_mini=your-deployment-name

# Option 3: Azure OpenAI (Alternate)
# AZURE_OPENAI_API_KEY=your_azure_key_here
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# AZURE_OPENAI_API_VERSION=2024-02-15-preview
# AZURE_OPENAI_CHAT_DEPLOYMENT_NAME=your-deployment-name

# ============================================
# OPTIONAL: Search and research tools
# ============================================

# Tavily API (for web search - https://tavily.com)
# TAVILY_API_KEY2=your_tavily_api_key_here

# NewsAPI (for news search - https://newsapi.org)
# NEWS_API_KEY=your_newsapi_key_here

# Firecrawl API (for web scraping - https://firecrawl.dev)
# FIRECRAWL_API_KEY=your_firecrawl_api_key_here

# ============================================
# OPTIONAL: Confidence thresholds (defaults shown)
# ============================================
# HIGH_CONFIDENCE_THRESHOLD=0.8
# MEDIUM_CONFIDENCE_THRESHOLD=0.5
# LOW_CONFIDENCE_THRESHOLD=0.3
